{
  "name": "starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config ./config/vite.config.ts",
    "dev:mock": "cross-env VITE_MSW=true vite --config ./config/vite.config.ts",
    "build": "tsc -b && vite build --config ./config/vite.config.ts",
    "build:mock": "cross-env VITE_MSW=true tsc -b && vite build --config ./config/vite.config.ts",
    "test": "vitest run --config ./config/vite.config.ts",
    "test:watch": "vitest --config ./config/vite.config.ts",
    "e2e": "playwright test --config ./config/playwright.config.ts",
    "e2e:ui": "playwright test --ui --config ./config/playwright.config.ts",
    "e2e:debug": "playwright test --debug --config ./config/playwright.config.ts",
    "lint": "eslint . --config ./config/eslint.config.js",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\" \"themes/**/*.{css,scss}\" --config ./config/stylelint.config.js",
    "format": "prettier . --config ./config/.prettierrc.json --write",
    "format:check": "prettier . --config ./config/.prettierrc.json --check",
    "preview": "vite preview --config ./config/vite.config.ts",
    "preview:mock": "cross-env VITE_MSW=true vite preview --config ./config/vite.config.ts",
    "scaffold": "plop --plopfile ./config/plopfile.cjs",
    "verify:skills": "node -e \"const fs=require('fs');const p='.github/skills';if(!fs.existsSync(p)){console.log('No local skills installed');process.exit(0);}const dirs=fs.readdirSync(p,{withFileTypes:true}).filter(d=>d.isDirectory()).map(d=>d.name);if(!dirs.length){console.log('No local skills installed');process.exit(0);}console.log('Installed local skills:');for(const d of dirs) console.log('- '+d);\"",
    "update:skills": "node ./config/update-skills.cjs",
    "postinstall": "node ./config/postinstall-customize.cjs",
    "prepare": "husky",
    "install:contrib": "AXA_KEEP_THEMES=true npm install"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,css,scss,md,json,yml,yaml,html}": [
      "prettier --config ./config/.prettierrc.json --write"
    ],
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --config ./config/eslint.config.js --fix"
    ],
    "*.{css,scss}": [
      "stylelint --config ./config/stylelint.config.js --fix"
    ]
  },
  "dependencies": {
    "@axa-fr/canopee-css": "^2.0.0-alpha.85",
    "@axa-fr/canopee-react": "^2.0.0-alpha.85",
    "@hookform/resolvers": "^5.9.1",
    "@material-symbols/svg-400": "^0.48.0",
    "@material-symbols/svg-700": "^0.48.0",
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "cssnano": "^9.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "plop": "^4.0.5",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-axe": "^0.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
